# ROADGUARD - Streamlit Secrets Configuration Template
# Copy this file to '.streamlit/secrets.toml' to enable Supabase Authentication, Database & Storage.

[supabase]
# Obtain your Supabase project URL & Anon Key from:
# Supabase Dashboard (https://supabase.com) -> Project Settings -> API
url = "https://your-project-id.supabase.co"
key = "your-supabase-anon-key-here"
redirect_url = "http://localhost:8501"
storage_bucket = "road-hazard-photos"

[app]
environment = "development"
admin_secret_token = "roadguard_admin_secure_key_2026"
default_city = "New York Metro, NY"

[database]
db_path = "roadguard.db"

[mapping]
# Optional external mapping API tokens (ROADGUARD functions fully offline/locally using OpenStreetMap & CartoDB)
mapbox_token = ""
google_maps_api_key = ""

[notifications]
# Optional webhook or SMS dispatch endpoint for municipal work order dispatching
alert_webhook_url = "https://api.roadguard.local/v1/alerts/dispatch"
enable_sms_dispatch = false
